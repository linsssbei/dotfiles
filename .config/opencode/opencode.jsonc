{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "mv *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "git reset *": "ask",
      "git rebase *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask"
    }
  }
}
